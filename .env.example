# ─────────────────────────────────────────────────────────────────
# MarketMind AI — Environment Variables
# Copy this file to .env and fill in your values.
# On Vercel: add these in Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────

# ── AI / LLM (Groq — free at console.groq.com) ───────────────────
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# ── Database ──────────────────────────────────────────────────────
# LOCAL dev: use SQLite
# DATABASE_URL="file:../db/custom.db"
#
# PRODUCTION (Vercel + Supabase): use PostgreSQL connection string
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=
DIRECT_URL=

# ── Supabase (supabase.com — free tier) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── NextAuth ──────────────────────────────────────────────────────
# On Vercel: set NEXTAUTH_URL to your production URL e.g. https://marketmind.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-32-char-string-here

# ── Google OAuth (console.cloud.google.com — free) ────────────────
# Add https://YOUR-DOMAIN.vercel.app/api/auth/callback/google to authorized redirect URIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# ── Stripe (stripe.com — free test mode) ─────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Image Generation ─────────────────────────────────────────────
GEMINI_API_KEY=
FAL_KEY=
HF_API_KEY=
