# Copy to .env and fill in. .env is gitignored.

# ---- Database ----
# Local/dev (default): SQLite
DATABASE_URL=file:../db/custom.db
#
# Supabase / Postgres (production): Supabase → Project Settings → Database → Connection string.
# Use the POOLED "Transaction" URL (port 6543) for DATABASE_URL and the DIRECT
# URL (port 5432) for DIRECT_URL. Then in prisma/schema.prisma set
# datasource `provider = "postgresql"` and add `directUrl = env("DIRECT_URL")`.
# DATABASE_URL="postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- AI provider (OpenAI-compatible chat completions) ----
# Powers email generation, website analysis, SEO, copywriting, etc.
# Works with any OpenAI-compatible API. Examples:
#   z.ai (GLM):  LLM_BASE_URL=https://api.z.ai/api/paas/v4        LLM_MODEL=glm-4.6
#   Groq (free): LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_MODEL=llama-3.3-70b-versatile
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.6
LLM_API_KEY=your-api-key-here
# Optional: vision-capable model so the AI can DESCRIBE an uploaded product image
# and reference it in the copy (defaults to LLM_MODEL, which for text-only models
# like llama-3.3-70b will skip analysis — the image is still attached to the email).
#   Groq vision:  LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   z.ai vision:  LLM_VISION_MODEL=glm-4.5v
#   OpenAI:       LLM_VISION_MODEL=gpt-4o-mini
# LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ---- Optional: web search (agents degrade gracefully to no external research if unset) ----
# SEARCH_API_URL=
# SEARCH_API_KEY=

# ---- Auth (NextAuth) ----
# For local dev NextAuth auto-detects the URL; set it to silence the warning.
# In production set it to your real https domain.
NEXTAUTH_URL=http://localhost:3000
# Long random string. Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# ---- Google login (optional) ----
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client (Web app).
# Authorized redirect URI must be:  <NEXTAUTH_URL>/api/auth/callback/google
# (e.g. http://localhost:3000/api/auth/callback/google for local dev)
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx
# Set this too so the "Continue with Google" button shows in the login modal:
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# ---- Payments (Stripe, optional) ----
# dashboard.stripe.com → Developers → API keys. Use TEST keys (sk_test_…) for the capstone.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Webhook signing secret — from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# (local) or Dashboard → Developers → Webhooks (production):
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
